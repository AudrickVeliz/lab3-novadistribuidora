# Copia este archivo como .env y escribe tu clave. .env no se sube a Git ni entra en las imágenes.

# Obligatoria: clave de OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Modelo que interpreta los mensajes, y el alterno si el principal falla (D-009).
MODELO=openai/gpt-6-luna
MODELO_ALTERNO=anthropic/claude-haiku-5.5

# Segundos máximos de espera por cada llamada al modelo.
TIEMPO_LIMITE_MODELO_S=10

# Servidor de MLflow que recibe las trazas. docker compose usa el suyo.
MLFLOW_TRACKING_URI=http://localhost:5000

# Carpeta de los archivos publicados (datos/*.parquet), relativa a la raíz del proyecto.
CARPETA_DATOS=datos
